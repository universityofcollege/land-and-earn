# Vercel Marketplace: Turso Cloud
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Vercel Storage: private Blob store
BLOB_READ_WRITE_TOKEN=

# Use public_demo only with demonstration data. Leave unset to require identity headers.
AUTH_MODE=public_demo
PROGRAM_MANAGER_EMAILS=
FISCAL_REVIEWER_EMAILS=

# Optional AI-assisted extraction
AI_EXTRACTION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
